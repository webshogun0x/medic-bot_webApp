# MediBot Web Dashboard Environment Variables
# Copy to .env.local for local development or set in Vercel Dashboard Project Settings

# Backend API Base URL (Leave empty or point to deployed backend, e.g. https://your-backend.vercel.app/api)
REACT_APP_API_URL=http://localhost:3000/api

# Firebase Web App Configuration (From Firebase Console > Project Settings > General > Your apps)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=medic-bot-health-monitor.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=medic-bot-health-monitor
REACT_APP_FIREBASE_STORAGE_BUCKET=medic-bot-health-monitor.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_DATABASE_URL=https://medic-bot-health-monitor-default-rtdb.firebaseio.com


